# TicketUG — environment template (values only in your secret store; never commit real secrets).
# Pair 6: Supabase-native backend — the NestJS API host is gone; Vercel + Supabase only.

# --- Next.js (Vercel) — the only application host ---
# Supabase Postgres connection string (session pooler; ticketug schema lives in
# this database). TLS: strict verification — the Supabase Root CA is bundled at
# certs/supabase-root-2021-ca.pem (see certs/README.md); override the path with
# SUPABASE_CA_CERT when rotating. rejectUnauthorized is never disabled.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase project URL (server-side only; the browser never talks to Supabase
# directly in this architecture — all auth traffic flows through Next.js).
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase publishable/anon key (Project Settings → API). Server-side only by
# design; safe by nature, kept out of browser bundles anyway.
SUPABASE_ANON_KEY=<publishable key from Supabase dashboard>
# Optional: order payment window in minutes (clamped 1..120, default 15).
PAYMENT_WINDOW_MINUTES=15

# --- Payments ---
# Only the simulated/test pathway exists today. It is REFUSED whenever the
# server process runs in production mode (next start / Vercel): 503
# TEST_PAYMENT_DISABLED. PAYMENT_MODE=test enables the simulated pathway ONLY
# in non-production runtimes (local dev / explicit staging processes). A live
# provider is an explicit GATE decision (CONTINUITY §12 row 6) — do not set
# PAYMENT_PROVIDER until approved.
# PAYMENT_MODE=test
# Webhook secret for the SIMULATED test provider (non-production only; the
# development default is inert in production).
# PAYMENT_TEST_WEBHOOK_SECRET=change-me-long-random-string

# --- Maintenance (optional) ---
# Guard for POST /api/system/orders/expire-stale (the order-expiry sweep).
# Unset → the endpoint 401s (fails closed). Wire an external scheduler to it.
# CRON_SECRET=change-me-long-random-string

# --- Migrations (scripts/migrate.mjs — pnpm migrate / pnpm migrate:status) ---
# Uses DATABASE_URL above. Ledger: ticketug.migration (000→012). Never destructive.

# --- Tests (optional) ---
# Enables the database integration suite (vitest); use a THROWAWAY/staging DB,
# never production.
# TEST_DATABASE_URL=postgres://user:password@staging-host/dbname?sslmode=require

# Removed since Pair 6 (do NOT set): API_ORIGIN, WEB_ORIGIN, API_PORT, API_HOST.
# Removed since Pair 5 (do NOT set): BETTER_AUTH_SECRET, NEON_AUTH_BASE_URL.
