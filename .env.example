# Ticket Uganda — environment template (values only in your secret store; never commit real secrets).
# Supabase-native backend — Vercel + Supabase only. The human-facing brand is
# "Ticket Uganda"; product/code identifiers (schema `ticketug`, QR prefix
# `ticketug:v1:`, PDF filename prefix) stay as-is by contract.

# --- Next.js (Vercel) — the only application host ---
# Supabase Postgres connection string (session pooler; ticketug schema lives in
# this database). TLS: strict verification — the Supabase Root CA is bundled at
# certs/supabase-root-2021-ca.pem (see certs/README.md); override the path with
# SUPABASE_CA_CERT when rotating. rejectUnauthorized is never disabled.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase project URL (server-side only; the browser never talks to Supabase
# directly in this architecture — all auth traffic flows through Next.js).
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase publishable/anon key (Project Settings → API). Server-side only by
# design; safe by nature, kept out of browser bundles anyway.
SUPABASE_ANON_KEY=<publishable key from Supabase dashboard>
# Canonical public origin — drives metadata, canonical URLs, sitemap, robots,
# JSON-LD and OG URLs. REQUIRED in production once the final domain exists
# (falls back to https://ticketug.vercel.app while on the Vercel domain).
# NEXT_PUBLIC_SITE_URL=https://www.your-domain.ug
# Optional: order payment window in minutes (clamped 1..120, default 15).
PAYMENT_WINDOW_MINUTES=15

# --- Payments ---
# Two provider surfaces are registered (lib/payments/provider.ts):
#
# 1. LIVE provider — NylonPay. Select with PAYMENT_PROVIDER=nylonpay and set
#    the three secrets below. Without them the adapter fails closed (503
#    PROVIDER_NOT_CONFIGURED). Webhook receiver (register in the NylonPay
#    merchant dashboard):
#      https://<your-domain>/api/public/payments/webhooks/nylonpay
# PAYMENT_PROVIDER=nylonpay
# NYLONPAY_API_KEY=<from NylonPay merchant dashboard>
# NYLONPAY_API_SECRET=<from NylonPay merchant dashboard>
# NYLONPAY_WEBHOOK_SECRET=<the secret NylonPay signs webhooks with>
# Optional overrides (defaults are usually correct):
# NYLONPAY_BASE_URL=https://api.nylonpay.com   # only if NylonPay changes its API host
# NYLONPAY_WEBHOOK_TOLERANCE_SECONDS=300       # replay window on the signed timestamp
#
# 2. Simulated/test provider — non-production ONLY. REFUSED whenever the
#    server process runs in production mode (next start / Vercel): 503
#    TEST_PAYMENT_DISABLED. PAYMENT_MODE=test enables it only in local dev /
#    explicit staging processes. Keep both variables UNSET in production.
# PAYMENT_MODE=test
# PAYMENT_TEST_WEBHOOK_SECRET=change-me-long-random-string

# --- Maintenance (optional) ---
# Guard for POST/GET /api/system/orders/expire-stale (the order-expiry sweep —
# also wired to Vercel Cron daily 03:00 UTC in vercel.json). Unset → the
# endpoint 401s (fails closed).
# CRON_SECRET=change-me-long-random-string

# --- Migrations (scripts/migrate.mjs — pnpm migrate / pnpm migrate:status) ---
# Uses DATABASE_URL above. Ledger: ticketug.migration (000, 005→015 as present
# in docs/migrations/). Migrations run inside transactions; checksum drift
# fails loudly. Never destructive without an explicit, reviewed migration.

# --- Platform administration (operator tooling) ---
# scripts/provision-platform-admin.mjs grants a platform role to an EXISTING
# user:  node scripts/provision-platform-admin.mjs <email> [--role PLATFORM_ADMIN]
# It needs DATABASE_URL (above) and never touches passwords — the account
# itself is created in the Supabase Auth dashboard (owner's secret).

# --- Tests (optional) ---
# Enables the database integration suite (vitest); use a THROWAWAY/staging DB,
# never production.
# TEST_DATABASE_URL=postgres://user:password@staging-host/dbname?sslmode=require

# Removed since Pair 6 (do NOT set): API_ORIGIN, WEB_ORIGIN, API_PORT, API_HOST.
# Removed since Pair 5 (do NOT set): BETTER_AUTH_SECRET, NEON_AUTH_BASE_URL.
