# TicketUG — environment template (values only in your secret store; never commit real secrets).
# Deployment runbook: docs/TICKETUG_CONTINUITY.md §19 (Pair 5 — Supabase architecture).

# --- Next.js frontend (Vercel / Node host) ---
# Supabase Postgres connection string (session pooler; ticketug schema lives in
# this database). TLS: strict verification — the Supabase Root CA is bundled at
# certs/supabase-root-2021-ca.pem (see certs/README.md); override the path with
# SUPABASE_CA_CERT when rotating. rejectUnauthorized is never disabled.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase project URL (server-side only; the browser never talks to Supabase
# directly in this architecture — all auth traffic flows through Next.js).
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase publishable/anon key (Project Settings → API). Server-side only by
# design; safe by nature, kept out of browser bundles anyway.
SUPABASE_ANON_KEY=<publishable key from Supabase dashboard>
# Base URL of the hosted NestJS API. Vercel does NOT deploy apps/api — host it
# separately (Render/Railway/Fly/VPS) and point API_ORIGIN at it. The default
# http://localhost:4000 only works in local development.
API_ORIGIN=https://api.your-domain.example
# Optional: order payment window in minutes (clamped 1..120, default 15).
PAYMENT_WINDOW_MINUTES=15

# --- NestJS API (apps/api — host separately from the frontend) ---
# DATABASE_URL — same Supabase Postgres connection string as the frontend.
# SUPABASE_URL — same Supabase project URL (JWKS verification; no anon key needed).
# Optional SUPABASE_CA_CERT — path to a CA PEM overriding the bundled cert.
# CORS allow-list for browser calls.
WEB_ORIGIN=https://your-frontend.example
API_PORT=4000
API_HOST=0.0.0.0
# Guard for POST /api/v1/system/orders/expire-stale (unset = endpoint 401s, fails closed).
CRON_SECRET=change-me-long-random-string
# Payments: only the simulated/test pathway exists today. The test provider is
# REFUSED in production; a live provider is an explicit GATE decision
# (see docs/TICKETUG_CONTINUITY.md §12 row 6). Do not set PAYMENT_PROVIDER until approved.
# PAYMENT_PROVIDER=unselected
# PAYMENT_MODE=live
# Webhook secret for the SIMULATED test provider (staging only; non-production
# runtimes fall back to a development-only default that is inert in production).
# PAYMENT_TEST_WEBHOOK_SECRET=change-me-long-random-string

# --- Migrations (scripts/migrate.mjs — pnpm migrate / pnpm migrate:status) ---
# Uses DATABASE_URL above. Ledger: ticketug.migration. Never destructive.

# --- Tests (optional) ---
# Enables the database integration suite (pnpm api:test); use a THROWAWAY/staging DB, never production.
# TEST_DATABASE_URL=postgres://user:password@staging-host/dbname?sslmode=require
